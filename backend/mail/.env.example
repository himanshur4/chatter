PORT=5001

# Local development: RabbitMQ from `docker compose up -d rabbitmq` (same login as the root .env).
# In Docker these three are overridden by docker-compose.yml.
Rabbitmq_Host=localhost
Rabbitmq_Username=chatter
Rabbitmq_password=<RABBITMQ_PASS from the root .env>

# Resend (sends the OTP emails). The sender must use a domain verified in Resend.
RESEND_API_KEY=re_<your-api-key>
RESEND_FROM_EMAIL=Chatter <no-reply@your-domain.com>
