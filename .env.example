# Copy this file to `.env` (never commit `.env`: this repository is public).
# docker-compose.yml reads these values.

# RabbitMQ login: used to create the RabbitMQ user AND passed to the user + mail services.
# Generate a password with:  openssl rand -hex 24
RABBITMQ_USER=chatter
RABBITMQ_PASS=change-me

# Only used when you build the frontend image yourself (docker compose up --build).
# They end up in the browser bundle, so they are public URLs, not secrets.
# NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:5000
# NEXT_PUBLIC_CHAT_SERVICE_URL=http://localhost:5002
